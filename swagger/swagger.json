    "/auth/google": {
      "get": {
        "tags": ["Auth"],
        "summary": "Start Google OAuth 2.0 login",
        "description": "Initiates the Google OAuth 2.0 flow. Redirects the browser to Google's consent screen. Open this URL directly in a browser (not via fetch/XHR) so that the redirect chain and session cookie work correctly.",
        "responses": {
          "302": {
            "description": "Redirect to Google's OAuth consent screen",
            "headers": {
              "Location": {
                "description": "Google authorization URL",
                "schema": {
                  "type": "string",
                  "example": "https://accounts.google.com/o/oauth2/v2/auth?client_id=..."
                }
              }
            }
          },
          "500": { "description": "Google OAuth strategy not configured" }
        }
      }
    },
    "/auth/google/callback": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth 2.0 callback",
        "description": "Google redirects here after the user consents. On success, the server either (a) redirects to `CLIENT_URL` if it is configured, or (b) returns a JSON payload containing the authenticated user (and optionally a JWT). On failure, the user is redirected to `/auth/google/failure`.",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Authorization code returned by Google"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Opaque value passed through the flow (set by Passport)"
          }
        ],
        "responses": {
          "200": {
            "description": "Login successful. Returned when `CLIENT_URL` is not set and the server responds with JSON.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OAuthCallbackResponse" }
              }
            }
          },
          "302": {
            "description": "Redirect to `CLIENT_URL` (or to `/auth/google/failure` on error)",
            "headers": {
              "Location": {
                "description": "Frontend URL or failure URL",
                "schema": {
                  "type": "string",
                  "example": "http://localhost:3000/api-docs"
                }
              }
            }
          },
          "401": { "description": "Google authentication failed" }
        }
      }
    },
    "/auth/google/failure": {
      "get": {
        "tags": ["Auth"],
        "summary": "Google OAuth failure handler",
        "description": "Returned when the Google OAuth flow fails (user denied, invalid code, or account linking error).",
        "responses": {
          "401": {
            "description": "Google authentication failed",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          }
        }
      }
    },

