            "description": "Session ID (Mongo ObjectId)"
          }
        ],
        "responses": {
          "200": {
            "description": "Left session successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Session" }
              }
            }
          },
          "400": { "description": "Not an attendee" },
          "401": {
            "description": "Unauthorized — missing or invalid JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Missing or malformed Authorization header", "type": "UnauthorizedError" }
              }
            }
          },
          "404": { "description": "Session not found" }
        }
      }
    },

    "/resources": {
      "get": {
        "tags": ["Resources"],
        "summary": "Get all resources",
        "responses": {
          "200": {
            "description": "List of resources retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Resource" }
                }
              }
            }
          },
          "500": { "description": "Server error" }
        }
      },
      "post": {
        "tags": ["Resources"],
        "summary": "Create a new resource (protected)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResourceCreate" },
              "example": {
                "title": "Express Routing Guide",
                "url": "https://expressjs.com/en/guide/routing.html",
                "type": "link",
                "description": "Official Express routing documentation",
                "groupId": "650c1f1e2f3a4b5c6d7e8f90"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Resource created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resource" }
              }
            }
          },
          "400": {
            "description": "Bad Request — missing or invalid fields",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "type must be pdf, video, or link", "type": "BadRequestError" }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Missing or malformed Authorization header", "type": "UnauthorizedError" }
              }
            }
          }
        }
      }
    },
    "/resources/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "pattern": "^[a-f\\d]{24}$" },
          "description": "Resource ID (Mongo ObjectId)"
        }
      ],
      "get": {
        "tags": ["Resources"],
        "summary": "Get resource by ID",
        "responses": {
          "200": {
            "description": "Resource details retrieved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Resource" }
              }
            }
          },
          "400": { "description": "Invalid ID format" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Server error" }
        }
      },
      "put": {
        "tags": ["Resources"],
        "summary": "Update resource by ID (protected)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResourceUpdate" },
              "example": { "title": "Updated Guide", "type": "pdf" }
            }
          }
        },
        "responses": {
          "204": { "description": "Resource updated successfully (No Content)" },
          "400": {
            "description": "Bad Request — invalid or empty field",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "url must be a valid URL", "type": "BadRequestError" }
              }
            }
          },
          "401": {
            "description": "Unauthorized — missing or invalid JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Missing or malformed Authorization header", "type": "UnauthorizedError" }
              }
            }
          },
          "403": { "description": "Forbidden — not the uploader" },
          "404": { "description": "Resource not found" }
        }
      },
      "delete": {
        "tags": ["Resources"],
        "summary": "Delete resource by ID (protected)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Resource deleted successfully" },
          "401": {
            "description": "Unauthorized — missing or invalid JWT",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "Missing or malformed Authorization header", "type": "UnauthorizedError" }
              }
            }
          },
          "403": { "description": "Forbidden — not the uploader" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Server error" }
        }
      }
    },
    "/resources/group/{groupId}": {
      "get": {
        "tags": ["Resources"],
        "summary": "Get resources by group",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "pattern": "^[a-f\\d]{24}$" },
            "description": "Study group ID (Mongo ObjectId)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of resources for the group",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Resource" }
                }
              }
            }
          },
          "400": { "description": "Invalid ID format" },
          "404": { "description": "Study group not found" },
          "500": { "description": "Server error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the JWT returned from /auth/login, /auth/register, or /auth/google/callback."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "googleId": {
            "type": "string",
            "nullable": true,
            "description": "Google account ID (present only for OAuth users)",
            "example": "109876543210987654321"
          },
          "firstName": { "type": "string", "example": "John" },
          "lastName": { "type": "string", "example": "Doe" },
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "role": { "type": "string", "enum": ["student", "tutor", "admin"], "example": "student" },
          "major": { "type": "string", "example": "Computer Science" },
          "provider": {
            "type": "string",
            "enum": ["local", "google"],
            "description": "How the account was created",
            "example": "local"
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "UserCreate": {
        "type": "object",
        "required": ["firstName", "lastName", "email", "password", "major"],
        "properties": {
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 6,
            "example": "secret123"
          },
          "role": {
            "type": "string",
            "enum": ["student", "tutor", "admin"],
            "default": "student"
          },
          "major": {
            "type": "string",
            "minLength": 1,
            "example": "Computer Science"
          }
        }
      },
      "UserUpdate": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one field must be provided.",
        "properties": {
          "firstName": { "type": "string", "minLength": 1, "maxLength": 50 },
          "lastName":  { "type": "string", "minLength": 1, "maxLength": 50 },
          "email":     { "type": "string", "format": "email" },
          "password":  { "type": "string", "format": "password", "minLength": 6 },
          "role":      { "type": "string", "enum": ["student", "tutor", "admin"] },
          "major":     { "type": "string", "minLength": 1 }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "john@example.com" },
          "password": { "type": "string", "format": "password", "example": "secret123" }
        }
      },
      "AuthResponse": {
        "type": "object",
        "properties": {
          "token": { "type": "string", "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..." },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "OAuthCallbackResponse": {
        "type": "object",
        "description": "Returned from /auth/google/callback when the server responds with JSON instead of a redirect.",
        "properties": {
          "message": { "type": "string", "example": "Login successful" },
          "token": {
            "type": "string",
            "description": "Only present if the server signs a JWT in the callback.",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "StudyGroup": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "name": { "type": "string", "example": "CSE 341 Group 1" },
          "course": { "type": "string", "example": "CSE 341" },
          "description": { "type": "string", "example": "Web Services study team" },
          "ownerId": {
            "oneOf": [
              { "type": "string", "pattern": "^[a-f\\d]{24}$" },
              { "$ref": "#/components/schemas/User" }
            ],
            "description": "Either an ObjectId string or a populated User object."
          },
          "members": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string", "pattern": "^[a-f\\d]{24}$" },
                { "$ref": "#/components/schemas/User" }
              ]
            }
          },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "StudyGroupCreate": {
        "type": "object",
        "required": ["name", "course", "description", "ownerId"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "CSE 341 Group 1"
          },
          "course": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "example": "CSE 341"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "example": "Web Services study team"
          },
          "ownerId": {
            "type": "string",
            "pattern": "^[a-f\\d]{24}$",
            "example": "650c1f1e2f3a4b5c6d7e8f90"
          },
          "members": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f\\d]{24}$" }
          }
        }
      },
      "StudyGroupUpdate": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one field must be provided.",
        "properties": {
          "name":        { "type": "string", "minLength": 1, "maxLength": 100 },
          "course":      { "type": "string", "minLength": 1, "maxLength": 50 },
          "description": { "type": "string", "minLength": 1, "maxLength": 500 },
          "members": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f\\d]{24}$" }
          }
        }
      },
      "Session": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "groupId": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "date": { "type": "string", "format": "date-time" },
          "location": { "type": "string", "example": "Library Room 204" },
          "topic": { "type": "string", "example": "REST API design" },
          "description": { "type": "string", "example": "Review Express routing and middleware" },
          "attendees": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f\\d]{24}$" }
          }
        }
      },
      "SessionCreate": {
        "type": "object",
        "required": ["groupId", "date", "location", "topic"],
        "properties": {
          "groupId": {
            "type": "string",
            "pattern": "^[a-f\\d]{24}$",
            "example": "650c1f1e2f3a4b5c6d7e8f90"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "example": "2025-11-10T18:00:00.000Z"
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Library Room 204"
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "REST API design"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "example": "Review Express routing and middleware"
          },
          "attendees": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f\\d]{24}$" }
          }
        }
      },
      "SessionUpdate": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one field must be provided.",
        "properties": {
          "date":        { "type": "string", "format": "date-time" },
          "location":    { "type": "string", "minLength": 1, "maxLength": 200 },
          "topic":       { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "maxLength": 1000 },
          "attendees": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-f\\d]{24}$" }
          }
        }
      },
      "Resource": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "title": { "type": "string", "example": "Express Routing Guide" },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://expressjs.com/en/guide/routing.html"
          },
          "type": { "type": "string", "enum": ["pdf", "video", "link"], "example": "link" },
          "description": { "type": "string", "example": "Official Express routing documentation" },
          "groupId": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "uploadedBy": { "type": "string", "example": "650c1f1e2f3a4b5c6d7e8f90" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ResourceCreate": {
        "type": "object",
        "required": ["title", "url", "type", "groupId"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Express Routing Guide"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "https://expressjs.com/en/guide/routing.html"
          },
          "type": {
            "type": "string",
            "enum": ["pdf", "video", "link"],
            "example": "link"
          },
          "description": {
            "type": "string",
            "maxLength": 1000,
            "example": "Official Express routing documentation"
          },
          "groupId": {
            "type": "string",
            "pattern": "^[a-f\\d]{24}$",
            "example": "650c1f1e2f3a4b5c6d7e8f90"
          }
        }
      },
      "ResourceUpdate": {
        "type": "object",
        "minProperties": 1,
        "description": "At least one field must be provided.",
        "properties": {
          "title":       { "type": "string", "minLength": 1, "maxLength": 200 },
          "url":         { "type": "string", "format": "uri" },
          "type":        { "type": "string", "enum": ["pdf", "video", "link"] },
          "description": { "type": "string", "maxLength": 1000 }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Resource not found" },
          "type": {
            "type": "string",
            "description": "Error class name, set by the error handler",
            "example": "NotFoundError"
          }
        }
      }
    }
  }
}